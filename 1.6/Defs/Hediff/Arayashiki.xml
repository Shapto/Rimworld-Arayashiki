<?xml version="1.0" encoding="utf-8"?>
<Defs>
<HediffDef ParentName="InjuryBase">
    <defName>Arayashiki_Wound</defName>
    <label>arayashiki wound</label>
    <labelNoun>an arayashiki wound</labelNoun>
    <description>A cut that will never heal again. It burns quietly, and reopens whenever the blade draws near.</description>
    <hediffClass>Arayashiki.Hediff_ArayashikiWound</hediffClass>
    <isBad>true</isBad>
    <comps>
        <li Class="HediffCompProperties_TendDuration">
            <compClass>Arayashiki.HediffComp_TendArayashiki</compClass>
            <severityPerDayTended>0</severityPerDayTended>
        </li>
    </comps>
    <modExtensions>
        <li Class="Arayashiki.ModExtension_Arayashiki">
            <sheathed>Arayashiki_Sheathed</sheathed>
            <unsheathed>Arayashiki</unsheathed>
        </li>
    </modExtensions>
    <injuryProps>
        <painPerSeverity>0.0125</painPerSeverity>
        <bleedRate>0.06</bleedRate>
        <canMerge>false</canMerge>
    </injuryProps>
</HediffDef>
</Defs>