        <targetParams>
            <canTargetSelf>true</canTargetSelf>
            <canTargetPawns>false</canTargetPawns>
        </targetParams>
    </verbProperties>
    <comps>
        <li Class="Arayashiki.CompProperties_ArayashikiSwap">
            <switchTo>Arayashiki</switchTo>
        </li>
    </comps>
</AbilityDef>

