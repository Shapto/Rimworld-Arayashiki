<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <AbilityDef>
        <defName>Unsheathe</defName>
        <label>unsheathe</label>
        <description>Draw the blade.</description>
		<iconPath>Weapons/Arayashiki_Unsheathed</iconPath>
        <jobDef>CastAbilityOnThing</jobDef>
        <targetRequired>False</targetRequired>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0.5</warmupTime>
            <range>0</range>
			<soundCast>Unsheathe</soundCast>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Arayashiki.CompProperties_ArayashikiSwap">
                <switchTo>Arayashiki</switchTo>
            </li>
        </comps>
    </AbilityDef>

    <AbilityDef>
        <defName>Sheathe</defName>
        <label>sheathe</label>
        <description>Sheathe the blade.</description>
		<iconPath>Weapons/Arayashiki_Sheathed</iconPath>
        <jobDef>CastAbilityOnThing</jobDef>
        <targetRequired>False</targetRequired>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
        <verbProperties>
            <verbClass>Verb_CastAbility</verbClass>
            <warmupTime>0.5</warmupTime>
            <range>0</range>
			<soundCast>Sheathe</soundCast>
            <targetParams>
                <canTargetSelf>true</canTargetSelf>
                <canTargetPawns>false</canTargetPawns>
            </targetParams>
        </verbProperties>
        <comps>
            <li Class="Arayashiki.CompProperties_ArayashikiSwap">
                <switchTo>Arayashiki_Sheathed</switchTo>
            </li>
        </comps>
    </AbilityDef>

	<AbilityDef>
		<defName>SlayTheHeavens</defName>
		<label>Slay the Heavens - Tiansha</label>
		<description>Dash to a target and sever their connection to life. Those who are immortal fall like the rest.</description>
		<iconPath>Icons/SlayTheHeavens</iconPath>
		<cooldownTicksRange>1800~1800</cooldownTicksRange>
		<jobDef>CastAbilityOnThing</jobDef>
		<targetRequired>True</targetRequired>
		<displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
		<casterMustBeCapableOfViolence>true</casterMustBeCapableOfViolence>
		<verbProperties>
			<verbClass>Verb_CastAbility</verbClass>
			<warmupTime>0.5</warmupTime>
			<range>6</range>
			<requireLineOfSight>false</requireLineOfSight>
			<targetParams>
				<canTargetSelf>false</canTargetSelf>
				<canTargetPawns>true</canTargetPawns>
				<canTargetBuildings>false</canTargetBuildings>
			</targetParams>
		</verbProperties>
		<comps>
			<li Class="Arayashiki.CompProperties_DashAbility">
				<pointCost>50</pointCost>
				<runClass>Arayashiki.SlayTheHeavens</runClass>
			</li>
		</comps>
	</AbilityDef>

	<AbilityDef>
		<defName>ErasingMeErasingYou</defName>
